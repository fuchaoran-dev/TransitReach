node_modules/
dist/

# Env
.env
.env.*
!.env.example
*.local

# Raw GTFS feed downloads. These are NOT needed to run or build the site — the derived
# stop set in src/shared/data/rail/ is committed and compiled into the bundle. You only
# need these to regenerate it with `node scripts/build-rail-stops.mjs`.
#
# Do NOT ignore src/shared/data/rail/*.json — the build fails without them.
data/gtfs/

# OpenTripPlanner working files: the jar, the OSM extract, the GTFS copy and the built
# graph. All are large and reproducible — see routing/README.md for the exact commands.
# The three *-config.json files ARE committed; they are the engine's configuration.
routing/otp/*.jar
routing/otp/*.pbf
routing/otp/*.zip
routing/otp/graph.obj
routing/otp/*.obj
# Generated by scripts/expand-gtfs-frequencies.mjs
routing/otp/gtfs-rapid-rail-kl-expanded/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test output
coverage/

# AWS deployment artefacts: identifies your infrastructure, not the project.
routing/deploy/created-resources.txt
routing/deploy/*.pem

# screenshots
*.png
